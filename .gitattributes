# Auto detect text files and normalize line endings to LF
* text=auto

# GameMaker Studio files should always use LF
*.gml text eol=lf
*.yy text eol=lf
*.yyp text eol=lf
*.resource_order text eol=lf

# Ensure binary files are not modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
